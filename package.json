{
  "name": "storyflow-studio",
  "version": "1.0.0",
  "description": "StoryFlow Studio — Guided Hindi-first story-to-video studio with Ken Burns animation, voiceover, and publish pack",
  "type": "module",
  "scripts": {
    "test": "node test_modules.mjs",
    "test:smoke": "node test_smoke.mjs",
    "test:all": "node test_modules.mjs && node test_smoke.mjs",
    "serve": "npx serve .",
    "start": "node server.js",
    "build": "node scripts/build.mjs",
    "zip": "node scripts/zip.mjs"
  },
  "keywords": [
